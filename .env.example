PORT=3000
NODE_ENV=production
SESSION_SECRET=troque-por-uma-chave-grande-e-aleatoria

# Treinamento: https://api.sandbox.sankhya.com.br
# Producao: https://api.sankhya.com.br
SANKHYA_API_BASE_URL=https://api.sandbox.sankhya.com.br
# URL acessada no navegador, antes de /mge/system.jsp. Necessaria para visualizar boletos.
SANKHYA_OM_BASE_URL=https://seu-ambiente.sankhya.com.br
SANKHYA_INTEGRATION_TOKEN=seu-token-integracao
SANKHYA_CLIENT_ID=seu-client-id
SANKHYA_CLIENT_SECRET=seu-client-secret
# Protecao contra limite temporario do endpoint OAuth (opcionais).
SANKHYA_AUTH_RETRY_LIMIT=3
SANKHYA_AUTH_RETRY_BASE_MS=1000
SANKHYA_AUTH_RETRY_MAX_MS=10000

# Usuario tecnico com acesso as consultas/validacoes da API.
# O usuario logado no app continua sendo usado como conferente.
SANKHYA_ACCESS_USER=usuario-tecnico
SANKHYA_ACCESS_PASSWORD=senha-do-usuario-tecnico
# Renova a sessao direta apos 20 minutos sem uso (opcional).
SANKHYA_DIRECT_SESSION_IDLE_MS=1200000

# Opcional: período fixo para validar estimativas de frete na base de treinamento.
# Em produção, mantenha ambos vazios para usar os últimos três meses.
FRETE_ESTIMATIVA_DATA_INICIAL=
FRETE_ESTIMATIVA_DATA_FINAL=

# Integração servidor-servidor do atendimento WhatsApp. A chave nunca é enviada ao navegador.
WHATSAPP_API_URL=https://whatsapp-api.nortesulsementes.com
WHATSAPP_INTERNAL_API_KEY=


# Webhook REST do Bitrix24. Nunca disponibilize esta URL no frontend.
BITRIX_WEBHOOK_URL=https://seu-dominio.bitrix24.com.br/rest/usuario/token/
BITRIX_FUNNEL_NAME=Atualizacao Cadastral
BITRIX_FUNNEL_STAGE=Aguardando Contato
# Responsavel fixo dos cards. Quando preenchido, evita consultar user.get.
BITRIX_DEFAULT_ASSIGNED_BY_ID=132
# Opcional quando o webhook nao possui permissao de leitura de usuarios.
# Aceita CODUSU ou nome normalizado do Sankhya como chave e ID Bitrix como valor.
BITRIX_USER_MAP={"CODUSU_SANKHYA":123}
