PORT=3000
NODE_ENV=production
SESSION_SECRET=troque-por-uma-chave-grande-e-aleatoria

# Treinamento: https://api.sandbox.sankhya.com.br
# Producao: https://api.sankhya.com.br
SANKHYA_API_BASE_URL=https://api.sandbox.sankhya.com.br
SANKHYA_INTEGRATION_TOKEN=seu-token-integracao
SANKHYA_CLIENT_ID=seu-client-id
SANKHYA_CLIENT_SECRET=seu-client-secret

# Usuario tecnico com acesso as consultas/validacoes da API.
# O usuario logado no app continua sendo usado como conferente.
SANKHYA_ACCESS_USER=usuario-tecnico
SANKHYA_ACCESS_PASSWORD=senha-do-usuario-tecnico
